# vi jinjaTemplate.yml

- name: jinjatemplate for copying files from src to dest with multiple names using jinja
  hosts: rhel
  become: yes
  vars_files:
    - 19usernamelist.yml
  tasks:
    - name: start
      template:
        src: /root/ansible/19jinjafile.j2
        dest: /tmp/differentnamesfile

